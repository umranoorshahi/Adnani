# ════════════════════════════════════════
# ADNANI CONNECTED — Environment Variables
# Copy this to .env and fill in your values
# NEVER commit .env to Git
# ════════════════════════════════════════

# ── SERVER ──
NODE_ENV=production
PORT=3000

# ── DATABASE ──
# MongoDB Atlas URI (with TLS/SSL enabled)
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster.mongodb.net/adnani?retryWrites=true&w=majority&tls=true

# ── SECURITY ──
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_64_CHAR_HEX_STRING

# AES-256 field encryption key (32 bytes = 64 hex chars)
FIELD_ENCRYPTION_KEY=CHANGE_ME_64_CHAR_HEX_STRING

# ── CORS ──
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=https://dashing-gumption-af5ff9.netlify.app,https://adnaniconnected.com

# ── ADMIN PHONES ──
ADMIN_PHONES=9415061063,9839060377

# ── SMS GATEWAY (for real OTP delivery) ──
# MSG91 (India) — recommended for Indian numbers
MSG91_AUTH_KEY=
MSG91_SENDER_ID=ADNANI
MSG91_TEMPLATE_ID=

# ── OPTIONAL: Twilio ──
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ── RAILWAY / DEPLOYMENT ──
# These are set automatically by Railway
# RAILWAY_ENVIRONMENT=production

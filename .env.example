# ════════════════════════════════════════════
# ADNANI CONNECTED v3.0 — Environment Variables
# ════════════════════════════════════════════

NODE_ENV=production
PORT=3000

# MongoDB Atlas (TLS enabled)
MONGODB_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/adnani?retryWrites=true&w=majority&tls=true
MONGO_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/adnani

# JWT (64 hex chars minimum)
JWT_SECRET=GENERATE_WITH: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"

# AES-256 Field encryption (64 hex chars = 32 bytes)
FIELD_ENCRYPTION_KEY=GENERATE_WITH: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# CORS
ALLOWED_ORIGINS=https://umranoorshahi.github.io,https://dashing-gumption-af5ff9.netlify.app

# Admin phones (bypass approval)
ADMIN_PHONES=9415061063,9839060377

# Logging
LOG_LEVEL=info
